{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!blueprint",
      "!graft",
      "!**/.omp",
      "!**/.wrangler",
      "!**/.state",
      "!packages/database/generated",
      "!**/dist",
      "!**/build",
      "!**/.react-router",
      "!**/node_modules",
      "!**/*.css"
    ]
  }
}
